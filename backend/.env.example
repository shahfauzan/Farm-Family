# Copy to .env for local development. Use only placeholders in this file.

# Client configuration (publishable/anon key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only Edge Function secrets; configure real values in Supabase, not here.
OPENAI_API_KEY=replace_with_local_secret
OPENAI_MODEL=gpt-4.1-mini
OPENWEATHER_API_KEY=replace_with_local_secret
